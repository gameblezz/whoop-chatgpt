# Exact public origin, HTTPS required except localhost development.
APP_URL=http://localhost:3000
PORT=3000
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
# Set this to the email on your own WHOOP account. Other accounts cannot sign in.
WHOOP_ALLOWED_EMAIL=
# Generate once: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
DATABASE_PATH=./data/whoop.sqlite
# Optional until you enable chat. Keep both settings server-side.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
